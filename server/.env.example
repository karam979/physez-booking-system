# Copy to .env and fill in real values. Never commit .env. (DESIGN.md §8)
PORT=3000
# Matches the root docker-compose.yml Postgres 16 service (docker compose up -d)
DATABASE_URL=postgres://physez:physez@localhost:5432/physez
# Integration tests only — created automatically on first container startup
TEST_DATABASE_URL=postgres://physez:physez@localhost:5432/physez_test
JWT_SECRET=change-me
APP_TIMEZONE=Asia/Jerusalem
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:5174
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10
# Base URL of the n8n server, e.g. https://your-n8n-host.example.com
N8N_WEBHOOK_BASE_URL=http://localhost:5678
# Must match PHYSEZ_SHARED_SECRET in n8n; use a long random hex string
N8N_SHARED_SECRET=change-me
