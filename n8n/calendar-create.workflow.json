{
  "name": "PhysEZ — Create/update Google Calendar event",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "calendar-create",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "webhook-calendar-create",
      "name": "Webhook: calendar-create",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-460, 0],
      "webhookId": "physez-calendar-create"
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "version": 2 },
          "conditions": [
            {
              "leftValue": "={{ $json.headers['x-physez-secret'] }}",
              "rightValue": "={{ $env.PHYSEZ_SHARED_SECRET }}",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "check-secret",
      "name": "Shared secret valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [-240, 0]
    },
    {
      "parameters": {
        "calendar": { "__rl": true, "value": "={{ $env.GOOGLE_CALENDAR_ID }}", "mode": "id" },
        "start": "={{ $json.body.startAt }}",
        "end": "={{ $json.body.endAt }}",
        "additionalFields": {
          "summary": "=PhysEZ lesson ({{ $json.body.lessonType }})",
          "description": "=Booking {{ $json.body.bookingId }}\nLanguage: {{ $json.body.language }}\nNotes: {{ $json.body.notes || '—' }}"
        }
      },
      "id": "calendar-create",
      "name": "Google Calendar: create event",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.3,
      "position": [0, -100],
      "credentials": {
        "googleCalendarOAuth2Api": { "id": "REPLACE_ME", "name": "PhysEZ calendar" }
      },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.PHYSEZ_API_BASE }}/api/internal/n8n/calendar-result",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "X-PhysEZ-Secret", "value": "={{ $env.PHYSEZ_SHARED_SECRET }}" }]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ bookingId: $('Webhook: calendar-create').item.json.body.bookingId, status: 'synced', calendarEventId: $json.id }) }}",
        "options": {}
      },
      "id": "report-success",
      "name": "Report synced to PhysEZ",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [260, -180]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.PHYSEZ_API_BASE }}/api/internal/n8n/calendar-result",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "X-PhysEZ-Secret", "value": "={{ $env.PHYSEZ_SHARED_SECRET }}" }]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ bookingId: $('Webhook: calendar-create').item.json.body.bookingId, status: 'failed' }) }}",
        "options": {}
      },
      "id": "report-failure",
      "name": "Report failure to PhysEZ",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [260, -20]
    },
    {
      "parameters": {},
      "id": "reject-unauthorized",
      "name": "Ignore unauthorized call",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [0, 140]
    }
  ],
  "connections": {
    "Webhook: calendar-create": {
      "main": [[{ "node": "Shared secret valid?", "type": "main", "index": 0 }]]
    },
    "Shared secret valid?": {
      "main": [
        [{ "node": "Google Calendar: create event", "type": "main", "index": 0 }],
        [{ "node": "Ignore unauthorized call", "type": "main", "index": 0 }]
      ]
    },
    "Google Calendar: create event": {
      "main": [
        [{ "node": "Report synced to PhysEZ", "type": "main", "index": 0 }],
        [{ "node": "Report failure to PhysEZ", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": { "executionOrder": "v1" },
  "pinData": {}
}
