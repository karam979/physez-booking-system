# PhysEZ API systemd unit. Install with:
#   sudo cp deploy/physez-api.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now physez-api

[Unit]
Description=PhysEZ API (Node/Express)
After=network.target postgresql.service

[Service]
Type=simple
User=physez
WorkingDirectory=/srv/physez/server
EnvironmentFile=/srv/physez/server/.env
# Secure cookies and production error handling depend on this.
Environment=NODE_ENV=production
ExecStart=/usr/bin/node src/index.js
Restart=on-failure
RestartSec=5

# The API only ever writes to its upload directory.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/physez/server/uploads

[Install]
WantedBy=multi-user.target
